# Copy to .env.local — do not commit .env.local

NODE_ENV=development

# --- URLs: point to Nest when using remote auth / sync ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_AUTH_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_FILE_URL=

# Set "true" to use Nest for login, settings sync, activity (see auth-endpoints.ts)
NEXT_PUBLIC_ENABLE_REMOTE_AUTH=true
NEXT_PUBLIC_ENABLE_REMOTE_EXCEL_SYNC=true
NEXT_PUBLIC_ENABLE_REMOTE_ACTIVITY_SYNC=true

# Same DB as the API (Prisma schema + Next routes like /api/extracted-selections)
DATABASE_URL=postgresql://toolshub:toolshub_dev@localhost:5432/toolshub

# Same value as JWT_SECRET in tools-hub-api repo (needed for /api/* that read Bearer JWT)
JWT_SECRET=replace-with-long-random-secret

MAINTENANCE_MODE=false

# Local-only mode (no Nest): set REMOTE_* to false, point DATABASE_URL at your DB,
# and use local /api/auth (app_users / auth_sessions) if your schema matches scripts/db/schema.sql

# Playwright E2E (optional): npm run test:e2e — requires dev server on this URL
# E2E_BASE_URL=http://localhost:3000

# ماسح ضوئي / طابعة — جسر محلي (Tauri على Windows، المنفذ 8888)
BRIDGE_URL=http://127.0.0.1:8888
# BRIDGE_TOKEN=your-bridge-token
# الجسر يدعم: GET /health  GET /printer/health (أو printer_ok في /health)
